# Python 虚拟环境（本地核验用，不入库）
.venv/

# 依赖
node_modules/

# 核验中间产物
examples/verify/

# 生成的 PDF / HTML（由源文件编译产出，不入库）
examples/*.pdf
examples/*.html

# 打包产物
*.vsix

# 斜体字体为构建产物（由 tools/build_oblique_font.py 从系统 SimSun 生成，不入库）
assets/fonts/*.ttf
assets/fonts/*.woff2
assets/fonts/*.b64
assets/fonts/ob/
assets/fonts/_subset.ttf
assets/fonts/_coverage.txt

# GitHub 推送用的临时 payload 工具
tools/make_payload.js
tools/payload.json
tools/bintest.txt
tools/enc_probe.txt

# 系统/编辑器
.DS_Store
Thumbs.db
