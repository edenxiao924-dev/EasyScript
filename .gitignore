# Python 虚拟环境（本地核验用，不入库）
.venv/

# 依赖
node_modules/

# 核验中间产物
examples/verify/

# 生成的 PDF / HTML（由源文件编译产出，不入库）
examples/*.pdf
examples/*.html

# 打包产物
*.vsix

# 斜体字体的 TTF 构建中间产物（仅保留 woff2，可用 build_oblique_font.py 重建）
assets/fonts/*.ttf

# GitHub 推送用的临时 payload 工具
tools/make_payload.js
tools/payload.json

# 系统/编辑器
.DS_Store
Thumbs.db
