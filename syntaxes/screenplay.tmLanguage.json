{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Screenplay",
  "scopeName": "source.screenplay",
  "patterns": [
    { "include": "#frontmatter" },
    { "include": "#comments" },
    { "include": "#revise" },
    { "include": "#montage" },
    { "include": "#scene-heading" },
    { "include": "#sfx" },
    { "include": "#character-cue" },
    { "include": "#transition" },
    { "include": "#parenthetical" },
    { "include": "#pagebreak" },
    { "include": "#inline" }
  ],
  "repository": {
    "frontmatter": {
      "begin": "^(---)\\s*$",
      "end": "^(---)\\s*$",
      "contentName": "meta.frontmatter.screenplay",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.frontmatter.screenplay" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.frontmatter.screenplay" }
      },
      "patterns": [
        {
          "match": "^\\s*(title|author|contact|phone|email|date|draft|autonumber)\\s*(:)\\s*(.*)$",
          "captures": {
            "1": { "name": "entity.name.tag.frontmatter.screenplay" },
            "2": { "name": "punctuation.separator.key-value.screenplay" },
            "3": { "name": "string.unquoted.frontmatter.screenplay" }
          }
        },
        {
          "match": "^\\s*([A-Za-z_][\\w-]*)\\s*(:)\\s*(.*)$",
          "captures": {
            "1": { "name": "variable.other.frontmatter.screenplay" },
            "2": { "name": "punctuation.separator.key-value.screenplay" },
            "3": { "name": "string.unquoted.frontmatter.screenplay" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.screenplay",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.screenplay",
          "match": "(//).*$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.screenplay" }
          }
        }
      ]
    },
    "revise": {
      "begin": "(?i)^(revise)\\s*(\\{)",
      "end": "\\}",
      "contentName": "markup.changed.revision.screenplay",
      "beginCaptures": {
        "1": { "name": "keyword.control.revise.screenplay" },
        "2": { "name": "punctuation.curly.screenplay" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.curly.screenplay" }
      },
      "patterns": [
        { "name": "string.other.revision.new.screenplay", "match": "\\[[^\\]]*\\]" }
      ]
    },
    "montage": {
      "begin": "(?i)^(montage)\\s*(\\{)",
      "end": "\\}",
      "contentName": "meta.montage.screenplay",
      "beginCaptures": {
        "1": { "name": "keyword.control.montage.screenplay" },
        "2": { "name": "punctuation.curly.screenplay" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.curly.screenplay" }
      },
      "patterns": [
        { "include": "#character-cue" },
        { "include": "#parenthetical" },
        { "name": "markup.italic.montage-action.screenplay", "match": ".*" }
      ]
    },
    "scene-heading": {
      "patterns": [
        {
          "name": "entity.name.section.scene.screenplay",
          "match": "^#\\s+.*$"
        },
        {
          "name": "entity.name.section.scene.auto.screenplay",
          "match": "^(?:INT|EXT|EST|INT\\.\\s*\\/\\s*EXT|EXT\\.\\s*\\/\\s*INT)(?:[.\\s-].*)?$"
        }
      ]
    },
    "sfx": {
      "match": "(?i)^(SFX)(\\s*[:：]?\\s*)(.*)$",
      "captures": {
        "1": { "name": "keyword.control.sfx.screenplay" },
        "2": { "name": "punctuation.separator.sfx.screenplay" },
        "3": { "name": "markup.underline.screenplay" }
      }
    },
    "character-cue": {
      "patterns": [
        {
          "match": "^(@)(.+?)(VO|OS|CO)$",
          "captures": {
            "1": { "name": "punctuation.definition.entity.screenplay" },
            "2": { "name": "entity.name.type.character.screenplay" },
            "3": { "name": "storage.modifier.screenplay" }
          }
        },
        {
          "match": "^(@)(.+)$",
          "captures": {
            "1": { "name": "punctuation.definition.entity.screenplay" },
            "2": { "name": "entity.name.type.character.screenplay" }
          }
        }
      ]
    },
    "transition": {
      "name": "keyword.control.transition.screenplay",
      "match": "^\\s*--.*$"
    },
    "parenthetical": {
      "name": "string.quoted.other.parenthetical.screenplay",
      "match": "^\\s*[（(].*[）)]\\s*$"
    },
    "pagebreak": {
      "name": "punctuation.other.pagebreak.screenplay",
      "match": "^={3,}\\s*$"
    },
    "inline": {
      "patterns": [
        {
          "name": "markup.bold.screenplay",
          "match": "\\*\\*[^*\\n]+\\*\\*"
        },
        {
          "name": "markup.italic.screenplay",
          "match": "\\*[^*\\n]+\\*"
        },
        {
          "name": "markup.underline.screenplay",
          "match": "__[^_\\n]+__"
        }
      ]
    }
  }
}
